        <mxCell id="D02-16" value="Propietario y EDITOR expresan permisos persistidos. El modo móvil es una experiencia de interfaz; no crea un rol VIEWER ni revoca por sí solo el permiso de edición." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#243746;strokeColor=#657581;strokeWidth=1.3;fillColor=#FFFFFF;shape=note;size=16;fillColor=#FFF5DE;spacing=10;align=left;fontSize=13;" vertex="1" parent="1">
