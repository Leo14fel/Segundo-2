# Copy to /etc/sinapuml/sinapuml.env, chmod 600, and replace every CHANGE_ME.
AWS_REGION=us-east-1

# MongoDB replica set (Atlas or a separately managed replica set). Replace before starting.
SINAPUML_MONGODB_URI=CHANGE_ME_MONGODB_REPLICA_SET_URI

# Keep model selection outside the binary. Nova Premier reached EOL on 2026-09-14;
# Nova 2 Lite is the conservative active default for the deployment profile.
SINAPUML_BEDROCK_TEXT_MODEL=us.amazon.nova-2-lite-v1:0
SINAPUML_BEDROCK_VISION_MODEL=us.amazon.nova-2-lite-v1:0
SINAPUML_BEDROCK_TIMEOUT_SECONDS=300
SINAPUML_BEDROCK_TEXT_MAX_TOKENS=1024

# The EC2 IAM role supplies AWS credentials. Never put AWS_ACCESS_KEY_ID here.
SINAPUML_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS

# After CloudFront exists, replace this with its exact origin, for example:
# https://d1234567890abc.cloudfront.net
SINAPUML_WEBSOCKET_ALLOWED_ORIGINS=https://*.cloudfront.net

# whisper.cpp remains private on the same EC2 instance.
SINAPUML_ASSISTANT_WHISPER_URL=http://127.0.0.1:8093

# Vision pipeline remains configurable without changing code.
SINAPUML_ASSISTANT_VISION_TWO_PASS=false
SINAPUML_ASSISTANT_VISION_HYBRID=true
SINAPUML_ASSISTANT_VISION_HYBRID_MIN_CLASSES=4
SINAPUML_ASSISTANT_VISION_HYBRID_FALLBACK=false

# Optional Web Push. Generate a stable P-256 pair with scripts/generate-push-keys.mjs.
# Keep the private key on the backend only. Configure HTTPS and a real contact before enabling.
SINAPUML_PUSH_ENABLED=false
SINAPUML_PUSH_PUBLIC_KEY=
SINAPUML_PUSH_PRIVATE_KEY=
SINAPUML_PUSH_SUBJECT=
