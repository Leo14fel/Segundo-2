        <mxCell id="D02-12" value="Visitante: registrarse e iniciar sesión. La autenticación habilita el acceso; no es una generalización de roles." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#243746;strokeColor=#657581;strokeWidth=1.3;fillColor=#FFFFFF;shape=note;size=16;fillColor=#FFF5DE;spacing=10;align=left;fontSize=13;" vertex="1" parent="1">
