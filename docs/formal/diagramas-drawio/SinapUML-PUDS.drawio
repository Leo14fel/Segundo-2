              <mxPoint x="1042.0" y="260.0" />
              <mxPoint x="1042.0" y="209.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="D10-19" value="1. Integrante → Herramientas Vue: Grabar orden con permiso&lt;br&gt;2. Herramientas Vue → Voz y planner: POST audio WAV autenticado&lt;br&gt;3. Voz y planner → STT / IA: Transcribir audio con Whisper&lt;br&gt;4. STT / IA → Voz y planner: Texto transcrito&lt;br&gt;5. Voz y planner → STT / IA: Planificar sobre el documento actual&lt;br&gt;6. STT / IA → Voz y planner: Acciones candidatas&lt;br&gt;7. Voz y planner → Voz y planner: Resolver IDs y validar intención / UML&lt;br&gt;8. Voz y planner → Herramientas Vue: Propuesta + baseRevision&lt;br&gt;9. Integrante → Herramientas Vue: Revisar y confirmar Aplicar" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#243746;strokeColor=#657581;strokeWidth=1.3;fillColor=#FFFFFF;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontStyle=0;fontColor=#243746;" vertex="1" parent="1">
          <mxGeometry x="45" y="585" width="620" height="265" as="geometry" />
        </mxCell>
        <mxCell id="D10-20" value="10. Herramientas Vue → API / Colaboración: Comando STOMP + baseRevision&lt;br&gt;11. API / Colaboración → API / Colaboración: Comprobar permiso y revisión vigente&lt;br&gt;12. API / Colaboración → Proyecto y registros: Transacción: modelo, actividad y avisos&lt;br&gt;13. Proyecto y registros → API / Colaboración: Commit; nueva revisión&lt;br&gt;14. API / Colaboración → Otros clientes: Publicar operación confirmada&lt;br&gt;15. API / Colaboración → Herramientas Vue: Operación aplicada&lt;br&gt;16. Herramientas Vue → API / Colaboración: Recuperar documento autoritativo vía REST&lt;br&gt;A1. Voz y planner → Herramientas Vue: Error de audio / planificación&lt;br&gt;A2. API / Colaboración → Herramientas Vue: Rechazo de conflicto; resincronizar" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#243746;strokeColor=#657581;strokeWidth=1.3;fillColor=#FFFFFF;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontStyle=0;fontColor=#243746;" vertex="1" parent="1">
          <mxGeometry x="700" y="585" width="620" height="265" as="geometry" />
        </mxCell>
        <mxCell id="D10-21" value="Excepción / límite: audio inválido o revisión obsoleta. La propuesta de voz se devuelve a quien solicita; la edición confirmada se propaga al grupo. Compartir toda la propuesta de voz sigue por verificar." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#243746;strokeColor=#657581;strokeWidth=1.3;fillColor=#FFFFFF;shape=note;size=16;fillColor=#FFF5DE;spacing=10;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="45" y="845" width="1260" height="57" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
